<?xml version="1.0" encoding="utf-8"?>
<favorites xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3">
    <!-- Minimal first-run layout. Other app shortcuts are intentionally omitted. -->
    <resolve launcher:container="-101" launcher:screen="0" launcher:x="0" launcher:y="0">
        <favorite launcher:uri="#Intent;action=android.intent.action.DIAL;end" />
    </resolve>
    <resolve launcher:container="-101" launcher:screen="1" launcher:x="1" launcher:y="0">
        <favorite launcher:uri="#Intent;action=android.intent.action.VIEW;data=content%3A%2F%2Fcontacts%2Fpeople;end" />
    </resolve>
    <resolve launcher:container="-101" launcher:screen="3" launcher:x="3" launcher:y="0">
        <favorite launcher:uri="#Intent;action=android.intent.action.SENDTO;data=smsto%3A;end" />
        <favorite launcher:uri="smsto:" />
    </resolve>
    <prime-action launcher:container="-101" launcher:screen="2" launcher:x="2" launcher:y="0" launcher:action="drawer" />
    <prime-action launcher:screen="0" launcher:x="2" launcher:y="-1" launcher:action="search" />
    <appwidget launcher:packageName="self" launcher:className="app.lawnchair.smartspace.SmartspaceAppWidgetProvider" launcher:screen="0" launcher:x="0" launcher:y="0" launcher:spanX="3" launcher:spanY="2" />
</favorites>
