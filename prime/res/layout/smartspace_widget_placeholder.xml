<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextClock
        android:id="@+id/date"
        style="@style/EnhancedSmartspaceTextTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="@dimen/enhanced_smartspace_padding_top"
        android:format12Hour="EEE, MMM d · h:mm a"
        android:format24Hour="EEE, MMM d · HH:mm"
        android:text="@string/smartspace_widget_placeholder_date"
        android:textColor="@android:color/white"
        android:shadowColor="#40000000"
        android:shadowRadius="4" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical">
    <ImageView
        android:id="@+id/smartspace_live_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/smartspace_live_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
    <TextView
        android:id="@+id/smartspace_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="›"
        android:textSize="25sp"
        android:textColor="@android:color/white"
        android:contentDescription="@string/smartspace_widget"
        android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
